# Copie para .env.local para rodar o site local apontando para o seu Supabase.
# Sem estas variáveis, o site abre em modo demonstração (motor no navegador, sem IA, salvo só neste aparelho).
# São valores públicos (URL e publishable/anon key). NUNCA coloque aqui a chave da Claude API.
VITE_SUPABASE_URL=https://SEU-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
